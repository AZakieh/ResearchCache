# Storage — Cloudflare R2
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Cache metadata
REDIS_URL=redis://:researchcache@localhost:6379/0

# Database
DATABASE_URL=postgresql+asyncpg://researchcache:researchcache@localhost:5432/researchcache

# Security
DECISION_HMAC_SECRET=
ADMIN_SECRET=
ALLOWED_ORIGINS_PATH=allowlist.yaml

# Rate limiting
RATE_LIMIT_PER_MINUTE=100
MAX_OBJECT_SIZE_GB=500

# Observability
LOG_LEVEL=INFO
ENVIRONMENT=development

# Feature flags
ENABLE_API_KEY_AUTH=true
ENABLE_FEDERATED_IDENTITY=false
ENABLE_RESTRICTED_DATA=false
ENABLE_PARALLEL_FETCH=false
